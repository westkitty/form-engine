# Copy to .github/workflows/pages.yml ONLY after the owner approves public deployment.
# Note: GitHub Pages on a private repo requires a paid plan; the published site is public.
name: pages
on: { workflow_dispatch: {} }
permissions: { contents: read, pages: write, id-token: write }
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: npm }
      - run: npm ci
      - run: npm test
      - run: FORM_BASE=/${{ github.event.repository.name }}/ npx vite build --outDir dist-pages
      - uses: actions/upload-pages-artifact@v3
        with: { path: dist-pages }
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment: { name: github-pages }
    steps:
      - uses: actions/deploy-pages@v4
